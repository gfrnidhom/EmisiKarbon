{
  "name": "sekolah-lestari",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "cd server && bun --watch src/index.ts",
    "dev:web": "cd apps/web && vite",
    "dev:admin": "cd apps/admin && vite",
    "dev:petugas": "cd apps/petugas && vite",
    "build": "bun run build:web && bun run build:admin && bun run build:petugas",
    "build:web": "cd apps/web && tsc -b && vite build",
    "build:admin": "cd apps/admin && tsc -b && vite build",
    "build:petugas": "cd apps/petugas && tsc -b && vite build",
    "start": "cd server && bun src/index.ts",
    "seed": "cd server && bun run seed",
    "test": "cd server && bun test",
    "apk": "./android/build-apk.sh"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@tailwindcss/vite": "4",
    "@tanstack/react-query": "5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "date-fns": "^4.4.0",
    "idb-keyval": "^6.3.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.72.0",
    "next-themes": "^0.4.6",
    "qr-scanner": "^1.4.2",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.1.0",
    "react-router-dom": "7",
    "recharts": "3.8.0",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "4",
    "tesseract.js": "5.1.1",
    "tw-animate-css": "^1.4.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "sharp": "^0.35.5",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "workbox-window": "^7.4.1"
  }
}
